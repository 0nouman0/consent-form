# Copy to .env.local (local) and set the same names in your hosting provider. Never commit real values.

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY — bypasses row-level security. Required for credit deduction/refund, payment crediting
# and the Cashfree webhook. NEVER prefix with NEXT_PUBLIC_. Without it, billing fails closed (503).
SUPABASE_SERVICE_ROLE_KEY=

# ── Patient-name encryption (required; there is no fallback key) ─────────
PATIENT_NAME_ENCRYPTION_KEY=

# ── AI (Groq) ─────────────────────────────────────────────
GROQ_API_KEY=
# Optional model overrides (defaults shown)
# GROQ_CONTENT_MODEL=openai/gpt-oss-120b
# GROQ_TRANSLATION_MODEL=openai/gpt-oss-120b

# ── Cashfree payments ─────────────────────────────────────
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=
CASHFREE_ENV=sandbox
NEXT_PUBLIC_CASHFREE_ENV=sandbox
# Production return URLs must be https
NEXT_PUBLIC_SITE_URL=
